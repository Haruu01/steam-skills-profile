# Steam Web API key (required). Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional default SteamID64 (only useful for a single-user deployment).
STEAM_ID=

# Upstash Redis (required in production for caching + rate limiting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to sign the session cookie. Set a long random string in production.
SESSION_SECRET=

# Rate limiting (per client IP).
RATE_LIMIT=10
RATE_WINDOW_SECONDS=600
